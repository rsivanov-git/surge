#!name=Goutube
#!desc=Redirect shared YouTube video requests to clean goutu.be preview links. Requires HTTPS MITM. Does not change share-sheet or clipboard text.

# Short links and Shorts/live/embed links become canonical Goutube watch links.
# Watch URLs are rewritten only when marked as shared (si or feature=shared).
# Plain watch URLs must remain untouched: Goutube sends human visitors back to them.
# Query parameters, including tracking, playlist context and timestamps, are removed.
# HTTPS requires an enabled MITM engine and an installed, trusted Surge CA.
# Apps with certificate pinning or links opened directly in YouTube may bypass this.

[URL Rewrite]
^https?://(?:www\.)?youtu\.be/([A-Za-z0-9_-]{11})/?(?:\?[^#]*)?(?:#.*)?$ https://goutu.be/watch?v=$1 302
^https?://(?:(?:www|m|music)\.)?youtube\.com/(?:shorts|live|embed)/([A-Za-z0-9_-]{11})/?(?:\?[^#]*)?(?:#.*)?$ https://goutu.be/watch?v=$1 302
^https?://(?:(?:www|m|music)\.)?youtube\.com/watch\?(?=(?:[^&#]*&)*(?:si=[^&#]+|feature=shared)(?:&|#|$))(?:[^&#]*&)*v=([A-Za-z0-9_-]{11})(?:&[^#]*)?(?:#.*)?$ https://goutu.be/watch?v=$1 302

[MITM]
hostname = %APPEND% youtu.be, www.youtu.be, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com
